# Копирай този файл като android/keystore.properties и попълни стойностите.
# САМИЯТ keystore.properties е в .gitignore и НИКОГА не влиза в repo-то.
#
# Създаване на ключа (веднъж, пази го като зеницата на окото си):
#
#   keytool -genkey -v -keystore ~/iforget-upload.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias iforget
#
# Виж store/google-play.md за пълните стъпки.

# АБСОЛЮТЕН път до .jks файла (относителен би се смятал спрямо android/app/).
storeFile=/Users/ИМЕТО_ТИ/iforget-upload.jks
storePassword=
keyAlias=iforget
keyPassword=
