rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Собственикът чете/пише само своя документ.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin акаунтът (за статистиката в профила) чете цялата колекция
      // само за преглед — НЕ може да пише в чужди документи.
      allow read: if request.auth != null
                   && request.auth.token.email == 'neshovska@yahoo.com';
    }

    // Anti-abuse throttle за sendBrandedPasswordReset (виж functions/index.js)
    // — четен/писан САМО от Cloud Function-а през Admin SDK (Admin SDK
    // напълно заобикаля тия правила по дизайн). За клиента (уеб/апп)
    // изрично забранено — иначе всеки логнат/анонимен клиент би могъл
    // директно да чете/трие throttle бройката и да заобиколи лимита.
    match /password_reset_throttle/{docId} {
      allow read, write: if false;
    }

    // Anti-abuse throttle за sendBrandedEmailVerification (виж
    // functions/index.js) — същия принцип като password_reset_throttle
    // по-горе, само че ключуван по uid (не email), защото тук потребителят
    // вече е логнат (request.auth изисква се във функцията).
    match /email_verification_throttle/{docId} {
      allow read, write: if false;
    }

    // Ограничител за смяна на имейл (sendBrandedEmailChange, същия принцип,
    // също по uid). Отделна колекция от verification-а нарочно: двете са
    // различни действия и не бива да си изяждат квотата — човек може да
    // потвърждава регистрацията си и същевременно да сменя адреса.
    match /email_change_throttle/{docId} {
      allow read, write: if false;
    }

    // Обратна връзка от приложението (виж renderFeedbackForm() в index.html).
    // Всеки ВЛЯЗЪЛ потребител може само да СЪЗДАДЕ съобщение — не може да
    // чете чуждите, нито да редактира или трие своето. Чете само админският
    // акаунт (renderFeedbackInbox()).
    // uid се проверява срещу request.auth.uid, за да не може някой да праща
    // съобщения от чуждо име; дължината е ограничена, за да не се пълни
    // базата с огромни записи.
    match /feedback/{docId} {
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 2000;
      allow read: if request.auth != null
                   && request.auth.token.email == 'neshovska@yahoo.com';
      allow update, delete: if false;
    }

    // Premium инфраструктура (виж CLAUDE.md за пълния план) — ПОДГОТВЕНА,
    // но неактивна, докато config/premium.enabled не стане true.

    // Главен "ключ" за Premium функционалността — ПУБЛИЧНО четим (дори без
    // логин, index.html чете това още при зареждане на апа), но пишем се
    // САМО ръчно от Firebase Console (Owner акаунта), никога от клиент/код —
    // точно това е "активирането", което потребителят иска да може да прави
    // сам, без redeploy.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Платежен статус на потребителя — пише се САМО от stripeWebhook Cloud
    // Function-а (Admin SDK, след реално потвърдено плащане от Stripe),
    // НИКОГА от клиента — иначе всеки логнат потребител би могъл директно
    // да си самозапише {premium:true} в собствения си документ.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
